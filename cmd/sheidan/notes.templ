package main

import (
	"fmt"

	"github.com/cybtachyon/sheidan/internal/models"
)

// NotesView renders the notes list page: each note's title as a link to
// its detail page, and the title and body as sf-field editable fields,
// so the GopherJS client makes them inline editable.
templ NotesView(notes []models.Note) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Notes</title>
			@FieldStyles()
			<style>
				/* The view link inherits the heading's text style, so
				the title reads as a title, not a link. */
				.sf-view { color: inherit; text-decoration: none; }
			</style>
		</head>
		<body>
			<h1>Notes</h1>
			for _, note := range notes {
				<h2 class="sf-field" data-note-id={ note.ID } data-field="title"><a class="sf-view" href={ fmt.Sprintf("/note/%d", note.ID) }><span class="sf-value">{ note.Title }</span></a></h2>
				<p class="sf-field" data-note-id={ note.ID } data-field="body"><span class="sf-value">{ note.Body }</span></p>
			}
			<script src="/web/web.js"></script>
		</body>
	</html>
}
