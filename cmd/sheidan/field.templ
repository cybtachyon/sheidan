package main

// FieldStyles renders the CSS for the sf-field editable field
// component, shared by every page that renders editable fields.
templ FieldStyles() {
	<style>
		.sf-field .sf-edit { display: none; margin-left: 0.5em; }
		.sf-field:hover .sf-edit { display: inline-block; }
		.sf-field .sf-input { display: none; font: inherit; }
		.sf-field .sf-submit { display: none; margin-left: 0.25em; }
		/* The editing rules follow the hover rule, so they win
		the tie when both match. */
		.sf-field.editing .sf-value { display: none; }
		.sf-field.editing .sf-edit { display: none; }
		.sf-field.editing .sf-input { display: inline; }
		.sf-field.editing .sf-submit { display: inline-block; }
	</style>
}
