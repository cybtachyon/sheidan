package main

import "github.com/cybtachyon/sheidan/internal/models"

templ NoteView(note models.Note) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ note.Title }</title>
			<style>
				.sf-field .sf-edit { display: none; margin-left: 0.5em; }
				.sf-field:hover .sf-edit { display: inline-block; }
				.sf-field .sf-input { display: none; font: inherit; }
				.sf-field .sf-submit { display: none; margin-left: 0.25em; }
				/* The editing rules follow the hover rule, so they win
				the tie when both match. */
				.sf-field.editing .sf-value { display: none; }
				.sf-field.editing .sf-edit { display: none; }
				.sf-field.editing .sf-input { display: inline; }
				.sf-field.editing .sf-submit { display: inline-block; }
			</style>
		</head>
		<body>
			<h1 class="sf-field" data-note-id={ note.ID } data-field="title"><span class="sf-value">{ note.Title }</span></h1>
			<p class="sf-field" data-note-id={ note.ID } data-field="body"><span class="sf-value">{ note.Body }</span></p>
			<script src="/web/web.js"></script>
		</body>
	</html>
}
